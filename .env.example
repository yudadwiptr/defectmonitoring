# SQLite untuk development. Untuk PostgreSQL cukup ganti URL-nya, mis.
# postgresql://user:pass@host:5432/defectmonitor?sslmode=require
# (provider Prisma dipilih otomatis dari URL ini)
DATABASE_URL="file:./dev.db"

# Isi "true" supaya build di hosting mengisi data contoh saat database masih kosong
# SEED_IF_EMPTY=true

# URL publik aplikasi, dipakai untuk metadata Open Graph (opsional)
# NEXT_PUBLIC_APP_URL="https://defect.perusahaan.co.id"
